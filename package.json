{
  "name": "beamdrop",
  "version": "1.1.0",
  "description": "Self-hosted ephemeral QR-based file transfer and URL shortener with auto-destruction and Docker/standalone deployment.",
  "main": "server.js",
  "bin": {
    "beamdrop": "./deploy.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "deploy": "node deploy.js",
    "deploy:standalone": "node deploy.js standalone",
    "deploy:docker": "node deploy.js docker",
    "deploy:systemd": "node deploy.js systemd",
    "status": "node deploy.js status",
    "stop": "node deploy.js stop"
  },
  "keywords": [
    "qr-code",
    "file-transfer",
    "url-shortener",
    "link-shortener",
    "ephemeral",
    "self-hosted",
    "docker",
    "airdrop-alternative"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1"
  }
}
