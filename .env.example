# =====================================================
# BeamDrop — Configuration (.env)
# Copy this file to .env to customize your deployment:
#   cp .env.example .env
# =====================================================

# Port the web server listens on
PORT=3055

# Maximum allowed file upload size in Megabytes (MB)
MAX_FILE_SIZE_MB=150

# Default lifetime in minutes before files/links auto-destruct
FILE_TTL_MINUTES=60

# Optional Public Domain / Reverse Proxy URL (e.g. https://qr.example.com)
# Leave empty to auto-detect from request headers or local Wi-Fi LAN IP!
PUBLIC_URL=

